@article{11d972260890d7dddfad316fc39864fabfb6b61c,
title = {Household Appliance Commitment with Appliance Dependency Modelling},
year = {2019},
url = {https://www.semanticscholar.org/paper/11d972260890d7dddfad316fc39864fabfb6b61c},
abstract = {Smart home energy management is one of the main topics in demand side management. In the literature, many Home Energy Management Systems (HEMSs) are designed to optimally schedule the operation ofhousehold appliances. However, most of existing work ignores the lifestyle related requirements of the user on the appliances’ operational dependencies. In this paper, we propose a new household appliance commitment model that integrates both the operational constraints of individual appliances and the dependency constraints among them. In this sense, the proposed HEMS can more accurately reflect the end user’s lifestyle requirements. Several simulation scenarios are designed to validate the proposed HEMS.},
author = {F. Luo and G. Ranzi and M. Kolokotroni},
journal = {2019 IEEE International Conference on Communications, Control, and Computing Technologies for Smart Grids (SmartGridComm)},
volume = {null},
pages = {1-5},
doi = {10.1109/SmartGridComm.2019.8909706},
}

@article{5417241feef96819b4c70cdaaaf6c0a5b10f95f1,
title = {Review of power user profile research for power sale side release},
year = {2021},
url = {https://www.semanticscholar.org/paper/5417241feef96819b4c70cdaaaf6c0a5b10f95f1},
abstract = {With the gradual development of the electricity retail market, retail companies has gain more and more awareness of retail consumers’ behavior. The power user profile can help retail companies analyze users’ consumption characteristics and behavioral preferences, dig users’ potential needs, and improve the ability of providing users value-added services. This article first introduces the basic concept of power user profile and the related researches in other fields. Secondly, this paper focuses on several topics of power user profile such as data acquisition, profile label system and related data mining algorithms, as well as its applications. Finally, the future research directions are prospected.},
author = {Wenjiao Ding and Tao Yang and Bangcan Wang and Ciwei Gao and Dongyuan Yang and Hao Ming},
journal = {2021 IEEE Sustainable Power and Energy Conference (iSPEC)},
volume = {null},
pages = {2406-2411},
